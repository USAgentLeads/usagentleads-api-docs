{
  "openapi": "3.1.0",
  "info": {
    "title": "USAgentLeads API",
    "version": "2.0.0",
    "description": "API v2 prepared for the next application release. Deployment pending UI review. Legacy one-time purchases and v1 remain supported."
  },
  "servers": [
    {
      "url": "https://www.usagentleads.com/api/v2"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/coverage": {
      "get": {
        "operationId": "coverage",
        "summary": "Catalog coverage",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "security": []
      }
    },
    "/search/count": {
      "post": {
        "operationId": "count",
        "summary": "Count matches",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        }
      }
    },
    "/search/preview": {
      "post": {
        "operationId": "preview",
        "summary": "Preview masked records",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        }
      }
    },
    "/credits": {
      "get": {
        "operationId": "credits",
        "summary": "Get credit balance",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        }
      }
    },
    "/records": {
      "get": {
        "operationId": "records",
        "summary": "Read owned records",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "agents",
                "brokerages"
              ]
            }
          },
          {
            "name": "list",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                25,
                50,
                100
              ],
              "default": 25
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          }
        ]
      }
    },
    "/records/unlock": {
      "post": {
        "operationId": "unlock",
        "summary": "Unlock records",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockRequest"
              }
            }
          }
        }
      }
    },
    "/exports": {
      "get": {
        "operationId": "exports",
        "summary": "Export owned contacts",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Plan required"
          },
          "409": {
            "description": "Release, idempotency, or credit-limit conflict"
          },
          "429": {
            "description": "Rate or monthly quota exceeded"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "agents",
                "brokerages"
              ]
            }
          },
          {
            "name": "list",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "template",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "standard",
                "hubspot",
                "salesforce",
                "follow_up_boss",
                "apollo",
                "instantly"
              ],
              "default": "standard"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "countyFips": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "description": "Requires state"
          },
          "zip": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "mustHave": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "phone",
                "address",
                "license"
              ]
            },
            "maxItems": 4
          },
          "activeLicense": {
            "type": "boolean"
          },
          "organization": {
            "type": "string",
            "maxLength": 60
          },
          "orgType": {
            "type": "string",
            "enum": [
              "brokerage",
              "office",
              "branch",
              "team",
              "other"
            ]
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "agents",
              "brokerages"
            ]
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          }
        },
        "additionalProperties": false
      },
      "UnlockRequest": {
        "type": "object",
        "required": [
          "kind",
          "releaseId",
          "maxCredits",
          "idempotencyKey"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "agents",
              "brokerages"
            ]
          },
          "releaseId": {
            "type": "string"
          },
          "maxCredits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "ordinals": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "maxItems": 100
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        },
        "oneOf": [
          {
            "required": [
              "ordinals"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "filters"
                  ]
                },
                {
                  "required": [
                    "quantity"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "filters",
              "quantity"
            ],
            "not": {
              "required": [
                "ordinals"
              ]
            }
          }
        ]
      }
    }
  }
}
